# Provenrely API — copy to .env (git-ignored) and fill in. Never commit real values.

PORT=8000
# Comma-separated origins allowed to call the API (the frontend's URL)
CORS_ORIGIN=http://localhost:3000
# Reverse proxies in front of the app (Render/Railway: 1) so rate limits see the real client IP
TRUST_PROXY=0
# Where certificates are stored (a JSON file); mount a volume here in production
DATA_DIR=./data

# MST Testnet
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
# MST uses legacy (type 0) transactions
MST_LEGACY_TX=true
# MSTScan's Etherscan-compatible API, used by scans for recent transactions. Set empty to disable.
EXPLORER_API_URL=https://testnet.mstscan.com/api

# ProvenrelyRegistry and SafeSend addresses and the deploy block (written by `npm run post-deploy`).
# Empty REGISTRY_ADDRESS → flag checks and stats report "not configured".
REGISTRY_ADDRESS=
SAFESEND_ADDRESS=
DEPLOY_BLOCK=0
# Log scans for stats: blocks per query (MST limits ranges) and max queries per refresh
LOG_CHUNK_SIZE=2000
LOG_MAX_CHUNKS_PER_REFRESH=200
# Private key of the wallet holding RELAYER on the registry (anchors certificates, logs custody).
# Empty → certificates are stored unanchored (local development only). Keep it out of the repo and out of chat.
RELAYER_PK=
# Certificate issuance is refused (503) while the relayer holds less than this (tMSTC)
RELAYER_MIN_BALANCE=0.01

# Per-IP rate limits, "requests/seconds"
RATE_LIMIT_CERTIFICATES=5/3600
RATE_LIMIT_CUSTODY=20/3600
RATE_LIMIT_SCAN=30/60
RATE_LIMIT_EXPLAIN=30/60

# Shown as `issuer` in certificate bodies
ISSUER_NAME=Provenrely

# AI explanations (optional). Without a provider + key, explanations use the built-in templates.
# LLM_PROVIDER: anthropic | openai. The model only ever sees the scan result (address, verdict, score, reasons).
LLM_PROVIDER=
LLM_API_KEY=
# anthropic default: claude-opus-5-5. openai: required (no default).
LLM_MODEL=
LLM_TIMEOUT_MS=10000
# openai only: base URL of an OpenAI-compatible API
LLM_BASE_URL=
