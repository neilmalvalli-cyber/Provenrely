# Scam scenario wallets — copy to backend/.env.scenario (git-ignored) and fill in. Never commit real keys.
# Use throwaway testnet wallets only. Chain/contract settings are read from backend/.env (npm run post-deploy).

# Pays for the whole scenario (needs ~0.015 tMSTC plus gas)
SCENARIO_FUNDER_PK=
SCENARIO_VICTIM_PK=
SCENARIO_SCAMMER_PK=
SCENARIO_HOP1_PK=
# hop2 only receives, so an address is enough
SCENARIO_HOP2_ADDRESS=
# A wallet holding ISSUER on the registry (the ISSUER_ADDR you deployed with); needs a little gas
SCENARIO_ISSUER_PK=

# Optional (tMSTC)
SCENARIO_AMOUNT=0.01
SCENARIO_GAS_BUFFER=0.002
SCENARIO_SAFESEND_AMOUNT=0.001
SCENARIO_EXPLORER_URL=https://testnet.mstscan.com
