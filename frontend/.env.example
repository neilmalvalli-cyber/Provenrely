# Provenrely frontend configuration. Copy to .env.local and fill in.
# Everything here is public (NEXT_PUBLIC_* is inlined into the browser bundle at build time):
# never put secrets or private keys in this file or in .env.local.

# MST Testnet — chain id confirmed with eth_chainId on the RPC (0x5752035 = 91562037).
# Note: some MST docs list the hex as 0x5752c55, which is wrong; the app derives hex from this decimal.
NEXT_PUBLIC_MST_CHAIN_ID=91562037
NEXT_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_MST_EXPLORER_URL=https://testnet.mstscan.com

# Deployed contracts (leave empty until deployed; the UI shows a "not configured" state)
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_SAFESEND_ADDRESS=

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# true = every API call returns clearly labelled sample data (no backend needed)
NEXT_PUBLIC_USE_MOCKS=true
